<?xml version="1.0" encoding="utf-8"?>
<registry>

  <records interface="collective.venue.interfaces.IVenueSettings"
           prefix="collective.venue"
  />

  <records interface="plone.base.interfaces.resources.IBundleRegistry"
           prefix="plone.bundles/collective-venue-bundle"
  >
    <value key="enabled">True</value>
    <value key="jscompilation">++plone++collective.venue/collective-venue-bundle/remote.min.js</value>
    <value key="csscompilation">++plone++collective.venue/collective-venue.css</value>
    <value key="depends">plone</value>
  </records>

  <record name="plone.icon.contenttype/venue">
    <field type="plone.registry.field.TextLine">
      <title>Venue</title>
    </field>
    <value key="resource">++plone++bootstrap-icons/geo-alt.svg</value>
  </record>

</registry>
